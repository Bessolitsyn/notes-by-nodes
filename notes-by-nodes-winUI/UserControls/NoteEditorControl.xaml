<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="notes_by_nodes_winUI.UserControls.NoteEditorControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300" d:DesignWidth="400">

    <Grid>
        <StackPanel Padding="8">
            <TextBox x:Name="TitleTextBox" PlaceholderText="Title" Margin="0,0,0,8"/>
            <TextBox x:Name="DescriptionTextBox" PlaceholderText="Description" Margin="0,0,0,8"/>
            <TextBox x:Name="ContentTextBox" PlaceholderText="Content" 
                     TextWrapping="Wrap" AcceptsReturn="True" Height="200"/>
        </StackPanel>
    </Grid>
</UserControl>
