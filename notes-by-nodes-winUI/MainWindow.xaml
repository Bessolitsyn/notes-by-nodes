<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="notes_by_nodes_winUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:hlp="using:notes_by_nodes_winUI.Helpers" 
    xmlns:vm="using:notes_by_nodes_winUI.ViewModel"
    mc:Ignorable="d"
    Title="Notes by Nodes">


    <Grid  Style="{StaticResource WindowsGridStyle}">
        <Grid.Resources>
            
            <DataTemplate x:Key ="NoteTreeViewItemTemplate" x:DataType="vm:NoteViewModel">
                <muxc:TreeViewItem ItemsSource="{x:Bind ChildNodes, Mode=TwoWay}" Content="{x:Bind}">
                   
                    <muxc:TreeViewItem.ContentTemplate>
                        <DataTemplate x:DataType="vm:NoteViewModel">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{x:Bind Name, Mode=TwoWay}"/>
                                <TextBlock Text="{x:Bind ChildNodes.Count, Mode=OneWay}" FontSize="10"/>
                                <TextBlock Text="{x:Bind Description, Mode=TwoWay}" 
                                Width="200" FontSize="10" 
                                TextWrapping="Wrap" TextAlignment="Left"/>
                            </StackPanel>
                        </DataTemplate>
                    </muxc:TreeViewItem.ContentTemplate>
                </muxc:TreeViewItem>
            </DataTemplate>
            
            <DataTemplate x:Key ="BoxTreeViewItemTemplate" x:DataType="vm:BoxViewModel">
                <muxc:TreeViewItem ItemsSource="{x:Bind ChildNodes}">
                    
                    <muxc:TreeViewItem.ContentTemplate>
                        <DataTemplate x:DataType="vm:BoxViewModel">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{x:Bind Name, Mode=TwoWay}" FontSize="12" TextWrapping="Wrap" TextAlignment="Left"/>
                                <TextBlock Text="{x:Bind ChildNodes.Count, Mode=OneWay}" FontSize="8"/>

                            </StackPanel>
                        </DataTemplate>
                    </muxc:TreeViewItem.ContentTemplate>
                </muxc:TreeViewItem>
            </DataTemplate>

            <hlp:CustomTemplateSelector x:Key="TreeViewItemTemplateSelector"
                    BoxTemplate="{StaticResource BoxTreeViewItemTemplate}"
                    NoteTemplate="{StaticResource NoteTreeViewItemTemplate}"
            />

        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Padding="8" Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Button Command="{x:Bind  ViewModel.NewBoxCommand}" Content="📦" Margin="0,0,0,4" />
                <Button Command="{x:Bind  ViewModel.NewChildNodeCommand}" Content="📝" Margin="0,0,0,4"/>
                <Button Command="{x:Bind  ViewModel.RemoveNodeCommand}" Content="❌" Margin="0,0,0,4"/>
            </StackPanel>

            <muxc:TreeView
                x:Name="NodeTreeView" Margin="0,8,0,0" ItemTemplateSelector="{StaticResource TreeViewItemTemplateSelector}"
                ItemsSource="{x:Bind  ViewModel.NodesTree}"
                SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                TabNavigation="Cycle" 
                >
                <!--SelectionChanged="{x:Bind ViewModel.NodeTreeView_SelectionChanged}"-->
                <!--ItemTemplateSelector="{StaticResource TreeViewItemTemplateSelector}" > SelectionChanged="{x:Bind  ViewModel.Nod}"-->
                
                <!--<muxc:TreeView.ItemContainerStyle>
                    <Style TargetType="muxc:TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding  IsExpanded, Mode=TwoWay}"/>
                    </Style>
                </muxc:TreeView.ItemContainerStyle>-->
            
            </muxc:TreeView>
        </StackPanel>

        <!--<StackPanel>
            <StackPanel.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Text="New note" Command="{Binding NewNoteCommand}"/>
                    <MenuFlyoutItem Text="Remove note" Command="{Binding RemoveCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutSubItem Text="Open in...">
                        <MenuFlyoutItem Text="New tab" Command="{Binding ShowNoteInNewTabCommand}"/>
                        <MenuFlyoutItem Text="Graph viewer" 
                    Command="{Binding DataContext.OpenGraphViewerCommand, 
                    RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window}}"/>
                    </MenuFlyoutSubItem>
                </MenuFlyout>
            </StackPanel.ContextFlyout>
            --><!-- ... UI элементы ... --><!--
        </StackPanel>-->

        <TabView 
            TabItemsSource="{x:Bind  ViewModel.Tabs}" 
            SelectedIndex="{x:Bind  ViewModel.SelectedTabIndex, Mode=TwoWay}" 
            Grid.Column="1" IsAddTabButtonVisible="False"/>
    </Grid>
</Window>
